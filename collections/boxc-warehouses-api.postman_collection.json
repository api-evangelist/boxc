    {
      "id": "8dab7bd7-2aa0-41b6-93f2-d4dbdac258d1",
      "name": "Warehouses",
      "description": {
        "content": "The Warehouses resource allows you to retrieve location and identity information for a single warehouse or all warehouses. You should query this endpoint to retrieve an active list of fulfillment warehouses that customers can send their products to restock their inventory. The ```warehouse.id``` is used for selecting the warehouse while creating an inbound shipment or an order.\n",
        "type": "text/plain"
      },
