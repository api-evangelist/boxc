          "id": "5bf1f44b-813e-4ce7-afe7-e1047e4243b8",
          "name": "GET /track/{trackingNumber}",
          "request": {
            "name": "GET /track/{trackingNumber}",
            "description": {
              "content": "Get events for a shipment using its tracking number.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "track",
                ":trackingNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "The email address of the shipping address. Provide this to reveal images if you're not the owner of the shipment."
                },
                {
                  "disabled": false,
                  "key": "postal_code",
                  "value": "<string>",
                  "description": "The postal code of the shipping address. Provide this to reveal images if you're not the owner of the shipment. It will only work if the postal code is not revealed in the event history."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "trackingNumber",
                  "description": "(Required) The final tracking number or tracking number for a generic shipment label."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
