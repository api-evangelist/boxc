      "id": "bd83e75f-7ccd-45d8-9082-f421aeafb3f1",
      "name": "Invoices",
      "description": {
        "content": "Invoices and statements are generated weekly and include a summary of all transactions between the invoice's `start_date` and `end_date`. Users can export an itemized list of all transactions for a billing period in their account.",
        "type": "text/plain"
      },
