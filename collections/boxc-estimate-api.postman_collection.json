{
  "item": [
    {
      "id": "cdbef14c-ccd2-41e5-b4fe-cb8578200842",
      "name": "Estimate",
      "description": {
        "content": "The Estimate resource allows a user to retrieve the estimated cost of shipping a package based on weight, dimensions, entry point, destination, and other parameters. No services will be returned if a route can't be matched against the provided parameters.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4e2f3f8c-9add-4526-802b-798afe3969dc",
          "name": "GET /estimate",
          "request": {
            "name": "GET /estimate",
            "description": {
              "content": "Retrieves an estimate.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "estimate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "carrier",
                  "value": "",
                  "description": "The preffered last mile carrier the shipment should use for delivery."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<A-Z>",
                  "description": "(Required) The destination country in [ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) format."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "USD",
                  "description": "The ISO 4217 currency code for the **value** parameter and rates that are returned."
                },
                {
                  "disabled": false,
                  "key": "dg_codes",
                  "value": "<string|array>",
                  "description": "A string or array of [dangerous good codes](/#tag/DangerousGoods) contained in the shipment."
                },
                {
                  "disabled": false,
                  "key": "entry_point",
                  "value": "<string>",
                  "description": "(Required) The code for the drop off location. See [Entry Points](/#tag/EntryPoints) for a list of codes."
                },
                {
                  "disabled": false,
                  "key": "exit_point",
                  "value": "",
                  "description": "The IATA port where the shipment should enter for last mile delivery. Providing this limits results to only those routes with the matching port."
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "1",
                  "description": "The height of the shipment in CM."
                },
                {
                  "disabled": false,
                  "key": "insurance",
                  "value": "false",
                  "description": "By default all shipments except for BoxC Post include insurance covering up to $30 of the total item value including shipping cost. Setting this to true will increase the insured value for an additional fee."
                },
                {
                  "disabled": false,
                  "key": "irregular",
                  "value": "false",
                  "description": "Indicates this shipment was packaged in irregular shaped polybag or soft packaging to assist in calculating the volumetric weight."
                },
                {
                  "disabled": false,
                  "key": "is_return",
                  "value": "false",
                  "description": "Indicates this shipment is a return."
                },
                {
                  "disabled": false,
                  "key": "length",
                  "value": "15",
                  "description": "The length of the shipment in CM."
                },
                {
                  "disabled": false,
                  "key": "packages",
                  "value": ""
                },
                {
                  "disabled": false,
                  "key": "postal_code",
                  "value": "<string>",
                  "description": "The destination Postal Code or ZIP Code. Conditional."
                },
                {
                  "disabled": false,
                  "key": "province",
                  "value": "<string>",
                  "description": "The destination province / state code. Conditional."
                },
                {
                  "disabled": false,
                  "key": "signature_confirmation",
                  "value": "false",
                  "description": "The shipment requires signature confirmation."
                },
                {
                  "disabled": false,
                  "key": "terms",
                  "value": "",
                  "description": "The preferred incoterms."
                },
                {
                  "disabled": false,
                  "key": "value",
                  "value": "0",
                  "description": "The total value of the items to calculate tax and insurance. Used with <i>currency</i>."
                },
                {
                  "disabled": false,
                  "key": "weight",
                  "value": "<decimal>",
                  "description": "(Required) The weight of the shipment in KG."
                },
                {
                  "disabled": false,
                  "key": "width",
                  "value": "10",
                  "description": "The width of the shipment in CM."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
